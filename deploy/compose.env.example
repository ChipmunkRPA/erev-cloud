# eRev Cloud compose variables (docs/05-ARCHITECTURE.md §8.2 DPL-10 to DPL-13; DG-RUN-08; D-47).
#
# Placeholders only, and no master key. make compose-verify uses this file as it is and adds the
# three master keys and the three database passwords it generates for the run. For any other use,
# copy it outside the repository, replace every value and generate the keys and the passwords: the
# database's first start refuses the change-me placeholders below. Never commit real values; make
# secrets-check scans this file.

# Container PostgreSQL 17 on 127.0.0.1:5436. The bootstrap superuser password of the postgres image,
# used only inside the container by its init step.
EREV_COMPOSE_POSTGRES_PASSWORD=change-me-postgres-superuser

# Login passwords of erev_owner (migrate) and erev_app (api, worker), set by
# deploy/compose/initdb/01-roles.sql inside the container. At least 12 URL-safe characters
# (letters, digits, - and _), because compose.yaml places them in the database URLs. That script
# refuses these three placeholders (05 DPL-10): generate each password, for example with
# python3 -c "import secrets; print(secrets.token_urlsafe(24))".
EREV_COMPOSE_OWNER_PASSWORD=change-me-erev-owner
EREV_COMPOSE_APP_PASSWORD=change-me-erev-app

# CFG-26 master keys served by EnvSecretStore (EREV_KEY_PROVIDER=local): 64 lowercase hexadecimal
# characters each. No value is shipped: under production the api and the worker refuse to start
# on a placeholder (fewer than 16 distinct byte values) and on two equal keys. Generate each with
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# and keep them: data encrypted and chains signed under them cannot be read or verified without
# them. make compose-verify and make zap-baseline generate their own for the run.
EREV_COMPOSE_ENCRYPTION_KEY=
EREV_COMPOSE_AUDIT_HMAC_MASTER_KEY=
EREV_COMPOSE_SECURITY_EVENT_HMAC_KEY=

# CFG-09: the origin users reach, without a path. The verification stack is plain HTTP on the
# loopback port nginx publishes. A deployment served over TLS names its https origin. The session
# cookie is Secure unless this is an http origin on a loopback host, as here (05 SAR-09).
EREV_COMPOSE_PUBLIC_ORIGIN=http://127.0.0.1:8195

# CFG-17, CFG-18: the SMTP relay (STARTTLS, certificate verified against the host name) and the
# sender address. The host must resolve to public addresses only (05 SAR-15). These placeholders
# name a host that never resolves, so the local verification stack sends no mail: a message stays
# in the outbox and its delivery fails. Leave the user name and the password blank for a relay
# that needs no authentication.
EREV_COMPOSE_SMTP_HOST=smtp.example.invalid
EREV_COMPOSE_SMTP_PORT=587
EREV_COMPOSE_SMTP_USERNAME=
EREV_COMPOSE_SMTP_PASSWORD=
EREV_COMPOSE_SMTP_FROM=erev@example.invalid

# CFG-18, SAR-15: only for a relay on a private or loopback address, such as one on the stack's
# own network. true admits such an address for the SMTP relay and for nothing else; the second
# variable is the path, inside the api and worker containers, of the PEM file with the
# certificate authority that signed the relay's certificate (mount it with an override file).
# STARTTLS and certificate verification stay required.
EREV_COMPOSE_SMTP_PRIVATE_RELAY=false
EREV_COMPOSE_SMTP_CA_FILE=
