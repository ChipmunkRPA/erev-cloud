# State backend EXAMPLE (05 DPL-30: "backend.tf.example (GCS backend, never active)").
#
# This file is not read by Terraform: `terraform init -backend=false` is the only init the
# repository runs (DG-MK-tf-validate), so validation uses no state and no cloud access. An
# authorised operator who is later allowed to apply copies this file to backend.tf in a checkout
# that is NOT committed (backend.tf is not tracked) and replaces the placeholders.
#
# Why the bucket must be CMEK-encrypted and access-restricted: the state holds the two KEY-06
# database URLs generated by cloud_sql.tf (random passwords in state, 05 DPL-32). Treat the state
# bucket like a secret store: uniform bucket-level access, public access prevention, versioning,
# object retention, no human standing read access (RB-11), and `roles/storage.objectAdmin` for the
# deployment pipeline identity only.
#
# One state per project: staging and production are separate GCP projects (05 OPR-07), each with
# its own state bucket and its own tfvars file under envs/.

terraform {
  backend "gcs" {
    # Placeholders (UI-1): a bucket in the SAME project as the deployment it describes.
    bucket = "PLACEHOLDER-erev-tfstate-ENVIRONMENT"
    prefix = "erev/ENVIRONMENT"

    # CMEK for the state objects; a dedicated key (not one of the DPL-34 application keys), so
    # the state's blast radius stays separate from the data keys.
    kms_encryption_key = "projects/PLACEHOLDER_PROJECT_ID/locations/PLACEHOLDER_REGION/keyRings/erev-tfstate/cryptoKeys/erev-tfstate"

    # No credentials, access_token or impersonate_service_account here: the pipeline identity
    # authenticates through Application Default Credentials at run time.
  }
}
