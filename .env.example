# eRev Cloud local configuration. Copy to .env and replace placeholders. Never commit .env.
EREV_ENV=dev

# PostgreSQL 17 on 127.0.0.1:5432 (roles and databases provisioned by the supervisor; D-42)
# erev_owner: migrations and test schema reset only. erev_app: API, worker, CLI, seed, tests.
EREV_DB_OWNER_URL=postgresql://erev_owner:CHANGE_ME@127.0.0.1:5432/erev
EREV_DB_APP_URL=postgresql://erev_app:CHANGE_ME@127.0.0.1:5432/erev
EREV_TEST_DB_OWNER_URL=postgresql://erev_owner:CHANGE_ME@127.0.0.1:5432/erev_test
EREV_TEST_DB_APP_URL=postgresql://erev_app:CHANGE_ME@127.0.0.1:5432/erev_test
EREV_E2E_DB_OWNER_URL=postgresql://erev_owner:CHANGE_ME@127.0.0.1:5432/erev_e2e
EREV_E2E_DB_APP_URL=postgresql://erev_app:CHANGE_ME@127.0.0.1:5432/erev_e2e

# Ports (defaults are the docs/00-GOAL.md §5 values; override only in supervisor review worktrees, D-70)
EREV_API_PORT=8190
EREV_WEB_PORT=5270
EREV_E2E_API_PORT=8199
EREV_E2E_WEB_PORT=5279

# Recovery provider (ruling D-95): NATIVE (default with EREV_KEY_PROVIDER=local; make backup / make restore-verify
# with the DBA-provisioned BYPASSRLS roles of runbook RB-11) or MANAGED (default with gcp; Cloud SQL automated backups
# and PITR, 05 OPR-08). An explicit value must agree with the key provider. Leave unset to derive it.
# EREV_RECOVERY_PROVIDER=NATIVE
# Backup identity for `make backup` under NATIVE (runbook RB-04; supervisor only): erev_backup, read-only with
# BYPASSRLS on the same database (pg_dump as erev_owner is refused by FORCE ROW LEVEL SECURITY, 04 DB-14). Under
# MANAGED it must stay unset. Leave unset otherwise.
# EREV_BACKUP_URL=postgresql://erev_backup:CHANGE_ME@127.0.0.1:5432/erev

# Master keys (64 hex characters each), read through EnvSecretStore; per-tenant keys are derived by HKDF (DG-KRN-KEY-02). Production reads Secret Manager.
EREV_ENCRYPTION_KEY=CHANGE_ME_64_HEX
EREV_AUDIT_HMAC_MASTER_KEY=CHANGE_ME_64_HEX
EREV_SECURITY_EVENT_HMAC_KEY=CHANGE_ME_64_HEX

# Demo and e2e credentials (docs/02-PRD.md WLD-U-R1, WLD-U-R2)
EREV_DEMO_PASSWORD=Demo1234!Demo
EREV_DEMO_TOTP_SECRET=CHANGE_ME_BASE32

# AI (D-46). Tests always use the fake provider.
EREV_AI_PROVIDER=fake
EREV_AI_KILL_SWITCH=false
ANTHROPIC_API_KEY=

# Files and logs
EREV_FILE_ROOT=.data/files
EREV_LOG_LEVEL=INFO
EREV_LOG_FORMAT=json
EREV_RUN_DIR=.run

# Origin, CORS and proxies (docs/05-ARCHITECTURE.md CFG-09, CFG-10, CFG-25). make e2e sets the origin to port 5279.
EREV_PUBLIC_ORIGIN=http://127.0.0.1:5270
EREV_CORS_ORIGINS=
EREV_TRUSTED_PROXY_HOPS=0

# Workers (CFG-23). An empty EREV_WORKER_QUEUES means all eight queues (DG-KRN-JOB-11).
EREV_WORKER_CONCURRENCY=4
EREV_WORKER_QUEUES=

# Key provider (DG-KRN-KEY-03) and email backend (CFG-17). dev, test and e2e require local and fake.
EREV_KEY_PROVIDER=local
EREV_EMAIL_BACKEND=fake

# Metrics (CFG-20)
EREV_METRICS_ENABLED=false
EREV_METRICS_TOKEN=
