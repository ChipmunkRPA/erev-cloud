+def test_cand109_same_period_two_additions_keep_distinct_component_nodes_and_one_aggregate() -> (
+    None
+):
+    """Codex 1438 (a): two dated additions in ONE period (15 Aug 20,000.00 and 30 Aug 30,000.00 on
+    the same obligation; Codex's two-concession fixture) keep distinct ``concession_created_cum``
+    nodes per component (no duplicate node id; the TraceBuilder check untouched), one obligation
+    aggregate node per period end valued at their Σ that every node replays (``w.checked``
+    re-evaluates the whole trace), the share-based element's ``aggregate_node`` param naming that
+    aggregate, JET-05c posting the Σ once in the period, and every intent balanced."""
+    inception = date(2026, 1, 4)
+    version = w.sbc_version(1, inception, True, "1000000.00", grant=inception.isoformat())
+    first = w.concession("-20000.00", date(2026, 8, 15), reference="MOD-FIRST-20000", named=False)
+    second = w.concession("-30000.00", date(2026, 8, 30), reference="MOD-SECOND-30000", named=False)
+    steps = [
+        ("D", Y1, "400000"),
+        ("I", Y1, "400000.00"),
+        ("A", first.effective_date, first.modification_key),
+        ("A", second.effective_date, second.modification_key),
+    ]
+    bundle = w.with_performing_445(
+        w.units_world(
+            steps, [version], modifications=[first, second], quantity="400000", inception=inception
+        )
+    )
+    book = w.checked(bundle)  # every trace node reproduced by reevaluate
+    assert w.balanced(book)
+    found = w.nodes(book)
+    aggregate_id = f"concession_created_cum:{WARRANT}/{SUPPLY}:FY2026-P08"
+    aggregate = found[aggregate_id]
+    component_nodes = {
+        node_id: node
+        for node_id, node in found.items()
+        if node_id.startswith("concession_created_cum:")
+        and "/CONCESSION/" in node_id
+        and node_id.endswith(":FY2026-P08")
+    }
+    assert aggregate.value == "50000.00"
+    # Codex 1510: the aggregate cites exactly the component nodes (lineage) through the explicit
+    # sum formula — never one event at the total; each component node cites its producing event.
+    assert aggregate.formula_id == "rl.concession_total.v1" and aggregate.params["mode"] == "sum"
+    assert list(aggregate.inputs) == sorted(component_nodes)
+    assert all(isinstance(item, str) for item in aggregate.inputs)
+    for node in component_nodes.values():
+        [source] = node.inputs
+        assert not isinstance(source, str) and source.ref_type == "contract_event"
+        assert source.ref_id.startswith(f"{WARRANT}/EV-") and node.formula_id == "rl.concession.v1"
+    assert sorted(node.value for node in component_nodes.values()) == ["20000.00", "30000.00"]
+    assert len(component_nodes) == 2 and sorted(
+        aggregate.params["components"].split("|")
+    ) == sorted(node_id.split(":")[1] for node_id in component_nodes)
+    assert (
+        f"concession_created_cum:{WARRANT}/{SUPPLY}:FY2026-P07" not in found
+    )  # nothing before 15 Aug
+    element = found[f"share_based_reduction_element_cum:{KEY}:FY2026-P08"]
+    cited = [item for item in element.inputs if isinstance(item, str)]
+    assert aggregate_id not in cited  # never an element input (count-once numerator)
+    portion = next(found[item] for item in cited if item.startswith("concession_portion@"))
+    assert portion.params["aggregate_node"] == aggregate_id
+    assert w.role_net(book, "REFUND_LIABILITY", credit=True) == {
+        "FY2026-P08": 5_000_000
+    }  # JET-05c Σ once
+    assert all(
+        sum(1 for line in intent.lines if line.account_role == "REFUND_LIABILITY") <= 1
+        for intent in book.posting_intents
+        if intent.posting_period_key == "FY2026-P08"
+    )
