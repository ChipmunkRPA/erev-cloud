+def test_cand109_dated_components_conserve_the_quota_and_the_history_check_is_unchanged() -> None:
+    """Σ component created amounts = quota.a_posted per obligation; the exact / posted history
+    conservation (``check_history``) is untouched; a zero-posted addition (deferred targeted cent)
+    creates no component and no money."""
+    a = event_view(
+        CONTRACT_KEY,
+        3,
+        "ESTIMATE_CHANGED",
+        date(2023, 3, 1),
+        {"estimate": "VC-A", "version_no": "1"},
+        obligation_keys=(POB,),
+    )
+    b = event_view(
+        CONTRACT_KEY,
+        9,
+        "ESTIMATE_CHANGED",
+        date(2023, 9, 1),
+        {"estimate": "VC-A", "version_no": "2"},
+        obligation_keys=(POB,),
+    )
+    zero = event_view(
+        CONTRACT_KEY,
+        11,
+        "ESTIMATE_CHANGED",
+        date(2023, 11, 1),
+        {"estimate": "VC-A", "version_no": "3"},
+        obligation_keys=(POB,),
+    )
+    st, subject = _state([(a, 3_000), (b, 4_000), (zero, 0)])
+    components = rl._concessions(st, MU)
+    assert [c.created_amount for c in components] == [3_000, 4_000]
+    assert (
+        sum(c.created_amount for c in components) == st.refund_components[subject].a_posted == 7_000
+    )
+    history = {subject: sorted(st.concession_history, key=lambda item: item.order_key)}
+    cc.check_history(st, history)  # unchanged and still satisfied
+    quota = st.refund_components[subject]
+    assert isinstance(quota, Quota) and quota.x_exact == Fraction(70)
+    # Codex 1438 (c): a negative-exact, zero-posted deferred-cent portion the state contract permits
+    # is neither dropped nor re-rounded — exact conservation holds and it creates no component.
+    cent = ConcessionAddition(
+        subject,
+        zero.event_key,
+        zero.effective_date,
+        zero.order_key,
+        Fraction(-1, 300),
+        0,
+        "08",
+        "EMBEDDED",
+    )
+    dated = tuple(item for item in st.concession_history if item.event_key != zero.event_key)
+    shifted = dataclasses.replace(
+        st,
+        concession_history=(*dated, cent),
+        refund_components=MappingProxyType(
+            {
+                subject: ConcessionQuota(
+                    quota.x_exact - Fraction(1, 300), 7_000, revenue_basis="EMBEDDED"
+                )
+            }
+        ),
+    )
+    cc.check_history(
+        shifted, {subject: sorted(shifted.concession_history, key=lambda i: i.order_key)}
+    )
+    assert [c.created_amount for c in rl._concessions(shifted, MU)] == [3_000, 4_000]
+
