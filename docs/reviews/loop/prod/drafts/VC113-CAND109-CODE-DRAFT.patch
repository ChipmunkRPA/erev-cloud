+def test_cand109_two_additions_on_one_obligation_with_a_credit_between_them() -> None:
+    """Two dated additions on one POB (March 3,000; September 4,000): a May credit of 5,000 may
+    consume the March addition only (3,000 — September's origin follows it); an October credit of
+    5,000 consumes September's 4,000. Under the aggregate-origin inference the May credit would
+    have taken 5,000 of a single 7,000 component."""
+    march = event_view(
+        CONTRACT_KEY,
+        3,
+        "ESTIMATE_CHANGED",
+        date(2023, 3, 1),
+        {"estimate": "VC-A", "version_no": "1"},
+        obligation_keys=(POB,),
+    )
+    september = event_view(
+        CONTRACT_KEY,
+        9,
+        "ESTIMATE_CHANGED",
+        date(2023, 9, 1),
+        {"estimate": "VC-A", "version_no": "2"},
+        obligation_keys=(POB,),
+    )
+    st, subject = _state([(march, 3_000), (september, 4_000)])
+    components = rl._concessions(st, MU)
+    assert [(c.created_on, c.created_amount) for c in components] == [
+        (date(2023, 3, 1), 3_000),
+        (date(2023, 9, 1), 4_000),
+    ]
+    assert sum(c.created_amount for c in components) == st.refund_components[subject].a_posted
+    may = event_view(
+        CONTRACT_KEY, 5, "CREDIT_MEMO_RECORDED", date(2023, 5, 1), {"credit_memo_number": "CM-MAY"}
+    )
+    october = event_view(
+        CONTRACT_KEY,
+        10,
+        "CREDIT_MEMO_RECORDED",
+        date(2023, 10, 1),
+        {"credit_memo_number": "CM-OCT"},
+    )
+    consumed = rl._consume(
+        _ctx(),
+        TraceBuilder(engine_version=ENGINE_VERSION),
+        components,
+        [_memo(may, 5_000), _memo(october, 5_000)],
+        MU,
+        orders=_orders(st, may, october),
+    )
+    assert _consumed(consumed) == {
+        f"{march.event_key}/{subject}": [(may.event_key, 3_000)],
+        f"{september.event_key}/{subject}": [(october.event_key, 4_000)],
+    }
+    refunds = rl.Refunds(
+        components=tuple(consumed), refund_liabilities=(), balances={}, return_assets=()
+    )
+    assert [
+        refunds.concession_total(subject, d)
+        for d in (date(2023, 2, 28), date(2023, 4, 30), date(2023, 9, 30))
+    ] == [0, 3_000, 7_000]
+
