+def test_cand109_same_day_credit_consumes_only_an_addition_that_precedes_it_in_eng_06_order() -> (
+    None
+):
+    """The defined event ordering (ENG-06: effective date, record_seq, event key): a credit memo
+    recorded on the addition's day but before it (record_seq 4 < 5) consumes nothing; one recorded
+    after it (record_seq 6) consumes the addition."""
+    june = event_view(
+        CONTRACT_KEY,
+        5,
+        "ESTIMATE_CHANGED",
+        date(2023, 6, 10),
+        {"estimate": "VC-A", "version_no": "1"},
+        obligation_keys=(POB,),
+        record_seq=5,
+    )
+    st, subject = _state([(june, 2_500)])
+    before = event_view(
+        CONTRACT_KEY,
+        4,
+        "CREDIT_MEMO_RECORDED",
+        date(2023, 6, 10),
+        {"credit_memo_number": "CM-4"},
+        record_seq=4,
+    )
+    after = event_view(
+        CONTRACT_KEY,
+        6,
+        "CREDIT_MEMO_RECORDED",
+        date(2023, 6, 10),
+        {"credit_memo_number": "CM-6"},
+        record_seq=6,
+    )
+    components = rl._concessions(st, MU)
+    consumed = rl._consume(
+        _ctx(),
+        TraceBuilder(engine_version=ENGINE_VERSION),
+        components,
+        [_memo(before, 2_500), _memo(after, 2_500)],
+        MU,
+        orders=_orders(st, before, after),
+    )
+    assert _consumed(consumed) == {f"{june.event_key}/{subject}": [(after.event_key, 2_500)]}
+    # Without the event order (a caller that passes none) the date rule alone applies, as before.
+    dated_only = rl._consume(
+        _ctx(),
+        TraceBuilder(engine_version=ENGINE_VERSION),
+        components,
+        [_memo(before, 2_500), _memo(after, 2_500)],
+        MU,
+    )
+    assert _consumed(dated_only) == {f"{june.event_key}/{subject}": [(before.event_key, 2_500)]}
+
