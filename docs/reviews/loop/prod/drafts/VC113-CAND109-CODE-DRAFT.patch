+def test_cand109_fallback_without_conserving_dated_history_keeps_the_boundary_inference() -> None:
+    """A quota without dated history (an older producer) or whose history does not conserve the
+    quota keeps today's aggregate component from ``_concession_event`` — created on the inferred
+    boundary — so nothing changes for producers that write no history."""
+    may = event_view(
+        CONTRACT_KEY,
+        8,
+        "CONTRACT_AMENDED",
+        date(2023, 5, 31),
+        {"modification": "MOD-0531"},
+        obligation_keys=(POB,),
+    )
+    nov = event_view(
+        CONTRACT_KEY,
+        15,
+        "ESTIMATE_CHANGED",
+        date(2023, 11, 15),
+        {"estimate": "VC-CONC-2", "version_no": "1"},
+        obligation_keys=(POB,),
+    )
+    without, subject = _state([(nov, 6_000)], modification=may, history=False)
+    [aggregate] = rl._concessions(without, MU)
+    assert (
+        aggregate.created_on,
+        aggregate.created_amount,
+        aggregate.created_order,
+        aggregate.source_key,
+    ) == (date(2023, 5, 31), 6_000, None, f"{may.event_key}/{subject}")
+    short, _ = _state(
+        [(nov, 6_000)], modification=may, quota_posted=7_000
+    )  # history 6,000 ≠ quota 7,000
+    [aggregate] = rl._concessions(short, MU)
+    assert (aggregate.created_on, aggregate.created_amount) == (date(2023, 5, 31), 7_000)
+
