+from erev_engine.stages.state import (
+    AllocatedState,
+    ConcessionAddition,
+    ConcessionQuota,
+    EventView,
+    Quota,
+    SegmentCause,
+)
+from erev_engine.trace import TraceBuilder
+from support import bundles
+from support import cpc_worlds as w
+from support.cpc_worlds import KEY, SUPPLY, WARRANT, Y1
+from support.recognition import (
+    CONTRACT_KEY,
+    allocated_state,
+    book_context,
+    event_view,
+    obligation,
+    segment,
+)
+
+MU = 2
+START, END = date(2023, 1, 1), date(2023, 12, 31)
+POB = "POB-1"
+
+
+def _ctx():  # type: ignore[no-untyped-def]
+    return book_context(bundles.entity(start=START, months=12), book_code="ASC606", currency="USD")
+
+
+def _memo(event: EventView, amount: int) -> BillingDocumentOut:
+    line = Line(
+        event=event,
+        kind="CREDIT_MEMO",
+        number=f"CM-{event.record_seq}",
+        line_external_id=None,
+        obligation_key=None,
+        amount=amount,
+        tax_amount=0,
+        is_cancellable=False,
+        credited_invoice_number=None,
+        mode="ERP",
+        unconditional_date=None,
+        in_position=True,
+        unconditional_source=event,
+    )
+    return BillingDocumentOut(
+        document_key=event.event_key,
+        contract_key=CONTRACT_KEY,
+        kind="CREDIT_MEMO",
+        number=line.number,
+        effective_date=event.effective_date,
+        lines=(line,),
+        attribution=MappingProxyType({}),
+    )
+
+
+def _state(
+    additions: list[tuple[EventView, int]],
+    *,
+    modification: EventView | None = None,
+    history: bool = True,
+    quota_posted: int | None = None,
+) -> tuple[AllocatedState, str]:
+    """One complete obligation with a MODIFICATION segment (when given) and one TP_CHANGE segment
+    per addition; the CONCESSION quota is the aggregate of the additions unless ``quota_posted``
+    overrides it; the dated history is written when ``history``."""
+    segments = [segment(Fraction(400), 40_000, start=START, end=END)]
+    if modification is not None:
+        segments.append(
+            segment(
+                Fraction(400),
+                40_000,
+                start=START,
+                end=END,
+                effective=modification.effective_date,
+                basis="PROSPECTIVE",
+                cause=SegmentCause.MODIFICATION,
+                event_key=modification.event_key,
+            )
+        )
+    running = 40_000
+    for event, posted in additions:
+        running -= posted
+        segments.append(
+            segment(
+                Fraction(running, 100),
+                running,
+                start=START,
+                end=END,
+                effective=event.effective_date,
+                basis="PROSPECTIVE",
+                cause=SegmentCause.TP_CHANGE,
+                event_key=event.event_key,
+            )
+        )
+    ob = obligation(POB, segments, start=START, end=END)
+    events = [event for event, _ in additions] + ([] if modification is None else [modification])
+    base = allocated_state([ob], events=sorted(events, key=lambda ev: ev.order_key))
+    total = sum(posted for _, posted in additions) if quota_posted is None else quota_posted
+    quota = ConcessionQuota(Fraction(total, 100), total, revenue_basis="EMBEDDED")
+    dated = tuple(
+        ConcessionAddition(
+            ob.subject_key,
+            event.event_key,
+            event.effective_date,
+            event.order_key,
+            Fraction(posted, 100),
+            posted,
+            "08",
+            "EMBEDDED",
+        )
+        for event, posted in additions
+    )
+    st = dataclasses.replace(
+        base,
+        refund_components=MappingProxyType({ob.subject_key: quota}),
+        concession_history=dated if history else (),
+    )
+    return st, ob.subject_key
+
+
+def _orders(st: AllocatedState, *memo_events: EventView) -> dict[str, tuple[date, int, str]]:
+    return {ev.event_key: ev.order_key for ev in (*st.events, *memo_events)}
+
+
+def _consumed(components: list[rl.RefundComponent]) -> dict[str, list[tuple[str, int]]]:
+    return {
+        component.source_key: [(item.document_key, item.amount) for item in component.consumptions]
+        for component in components
+        if component.kind == rl.CONCESSION
+    }
+
+
+def test_cand109_vc_chk_113_shape_origin_is_the_november_producer_not_the_may_boundary() -> None:
+    """The VC-CHK-113 shape: a May 31 MODIFICATION segment on the software obligation, a November
+    15 targeted DISCOUNT that adds the 60.00 quota (one dated history entry), an unreferenced
+    October 31 credit of 100.00 and the December 10 concession credit of 60.00. The component is
+    created on November 15 from the producing ESTIMATE_CHANGED event; October consumes nothing
+    (its origin follows the memo); December consumes the 60.00 (JET-04b release)."""
+    may = event_view(
+        CONTRACT_KEY,
+        8,
+        "CONTRACT_AMENDED",
+        date(2023, 5, 31),
+        {"modification": "MOD-0531"},
+        obligation_keys=(POB,),
+    )
+    nov = event_view(
+        CONTRACT_KEY,
+        15,
+        "ESTIMATE_CHANGED",
+        date(2023, 11, 15),
+        {"estimate": "VC-CONC-2", "version_no": "1"},
+        obligation_keys=(POB,),
+    )
+    st, subject = _state([(nov, 6_000)], modification=may)
+    assert (
+        rl._concession_event(st, st.obligations[0]) is may
+    )  # the inference alone would date it May 31
+    components = rl._concessions(st, MU)
+    assert [
+        (
+            c.kind,
+            c.created_on,
+            c.created_amount,
+            c.created_ref.ref_id if c.created_ref else None,
+            c.created_order,
+        )
+        for c in components
+    ] == [(rl.CONCESSION, date(2023, 11, 15), 6_000, nov.event_key, nov.order_key)]
+    assert components[0].source_key == f"{nov.event_key}/{subject}"
+    october = event_view(
+        CONTRACT_KEY,
+        14,
+        "CREDIT_MEMO_RECORDED",
+        date(2023, 10, 31),
+        {"credit_memo_number": "CM-VC"},
+    )
+    december = event_view(
+        CONTRACT_KEY,
+        16,
+        "CREDIT_MEMO_RECORDED",
+        date(2023, 12, 10),
+        {"credit_memo_number": "CM-CONC"},
+        obligation_keys=(POB,),
+    )
+    consumed = rl._consume(
+        _ctx(),
+        TraceBuilder(engine_version=ENGINE_VERSION),
+        components,
+        [_memo(october, 10_000), _memo(december, 6_000)],
+        MU,
+        orders=_orders(st, october, december),
+    )
+    assert _consumed(consumed) == {f"{nov.event_key}/{subject}": [(december.event_key, 6_000)]}
+    refunds = rl.Refunds(
+        components=tuple(consumed), refund_liabilities=(), balances={}, return_assets=()
+    )
+    assert (
+        refunds.concession_total(subject, date(2023, 10, 31)),
+        refunds.concession_total(subject, date(2023, 11, 30)),
+    ) == (0, 6_000)
+    [component] = consumed
+    assert (
+        component.consumed_by(date(2023, 11, 30)),
+        [item.amount for item in component.consumed_by(date(2023, 12, 31))],
+    ) == ((), [6_000])
+
