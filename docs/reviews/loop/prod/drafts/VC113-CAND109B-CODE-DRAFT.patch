@@ -0,0 +1,125 @@
+"""D-98 candidate 109b (DRAFT; lane F-CTR): a refund-liability component an obligation owns
+(``RETURN``, ``CONCESSION``, ``UNCLAIMED_PROPERTY``) resolves the accounts of the roles that
+obligation overrides through the owner's ``account_overrides`` (T-REF-15 step 1), found by exact
+CV-21 encoded identity from the component key; every other path (mapping rules under the
+component's contract scope, line dimensions, the subject, contract-owned kinds) is unchanged.
+Codex 1517 focused cases. CPU only.
+"""
+
+from __future__ import annotations
+
+import dataclasses
+from datetime import date
+from fractions import Fraction
+from types import MappingProxyType
+
+from erev_engine.stages.s14_posting import intents
+from erev_engine.stages.s14_posting.accounts import resolve
+from erev_engine.stages.s14_posting.targets import RoleKey
+from support import bundles
+from support.recognition import (
+    CONTRACT_KEY,
+    allocated_state,
+    book_context,
+    event_view,
+    obligation,
+    segment,
+)
+
+START, END = date(2023, 1, 1), date(2023, 12, 31)
+GROUP = f"CG-{CONTRACT_KEY}@US01"
+
+
+def _ob(key: str, **overrides: str):  # type: ignore[no-untyped-def]
+    """An obligation whose subject key is ``<contract>/<key>`` with ``key`` already CV-21 encoded
+    (the support helper does not encode), carrying ``overrides`` as its account overrides."""
+    built = obligation(
+        key, [segment(Fraction(400), 40_000, start=START, end=END)], start=START, end=END
+    )
+    return dataclasses.replace(built, account_overrides=MappingProxyType(dict(overrides)))
+
+
+def _state(*obs, with_event: bool = True):  # type: ignore[no-untyped-def]
+    events = (
+        [
+            event_view(
+                CONTRACT_KEY,
+                15,
+                "ESTIMATE_CHANGED",
+                date(2023, 11, 15),
+                {"estimate": "VC-1", "version_no": "1"},
+            )
+        ]
+        if with_event
+        else []
+    )
+    return allocated_state(list(obs), events=events)  # no OPENING_BALANCE_ESTABLISHED: no baseline
+
+
+EVENT = f"{CONTRACT_KEY}/EV-000015"
+
+
+def test_cand109b_owner_by_exact_encoded_identity_and_none_for_contract_owned_kinds() -> None:
+    pob2 = _ob("POB %232", CONTRACT_LIABILITY="21002")  # "POB #2" encoded
+    st = _state(pob2)
+    assert intents._owner_obligation(st, f"{GROUP}/CONCESSION/{EVENT}/{pob2.subject_key}") is pob2
+    assert intents._owner_obligation(st, f"{GROUP}/RETURN/{pob2.subject_key}") is pob2
+    assert intents._owner_obligation(st, f"{GROUP}/UNCLAIMED_PROPERTY/{pob2.subject_key}") is pob2
+    # Contract-owned kinds never infer an obligation; ordinary subjects have no owner.
+    assert intents._owner_obligation(st, f"{GROUP}/TERMINATION/{CONTRACT_KEY}/EV-000009") is None
+    assert (
+        intents._owner_obligation(st, f"{GROUP}/VARIABLE_CONSIDERATION/{CONTRACT_KEY}/VC-1") is None
+    )
+    assert intents._owner_obligation(st, pob2.subject_key) is None
+    assert intents._owner_obligation(st, f"{CONTRACT_KEY}@US01") is None
+    # The CONCESSION event key must be an event of the state; a foreign or malformed prefix is None.
+    assert (
+        intents._owner_obligation(
+            st, f"{GROUP}/CONCESSION/{CONTRACT_KEY}/EV-000099/{pob2.subject_key}"
+        )
+        is None
+    )
+    assert (
+        intents._owner_obligation(
+            _state(pob2, with_event=False), f"{GROUP}/CONCESSION/{EVENT}/{pob2.subject_key}"
+        )
+        is None
+    )
+
+
+def test_cand109b_encoded_delimiters_are_exact_never_suffix_matched() -> None:
+    slash = _ob("A%2FB", CONTRACT_LIABILITY="21001")  # obligation key "A/B" encoded
+    plain = _ob("B", CONTRACT_LIABILITY="21002")
+    st = _state(slash, plain)
+    assert intents._owner_obligation(st, f"{GROUP}/CONCESSION/{EVENT}/{slash.subject_key}") is slash
+    assert intents._owner_obligation(st, f"{GROUP}/CONCESSION/{EVENT}/{plain.subject_key}") is plain
+    assert intents._owner_obligation(st, f"{GROUP}/RETURN/{slash.subject_key}") is slash
+    # A raw, unencoded form is not an identity of the state.
+    assert intents._owner_obligation(st, f"{GROUP}/CONCESSION/{EVENT}/{CONTRACT_KEY}/A/B") is None
+    assert intents._owner_obligation(st, f"{GROUP}/RETURN/{CONTRACT_KEY}/A/B") is None
+
+
+def test_cand109b_two_obligations_take_their_own_overrides_and_fall_back_without_one() -> None:
+    first = _ob("POB-1", CONTRACT_LIABILITY="21001")
+    second = _ob("POB %232", CONTRACT_LIABILITY="21002")
+    st = _state(first, second)
+    ctx = book_context(bundles.entity(start=START, months=12), book_code="ASC606", currency="USD")
+    for ob in (first, second):
+        component = f"{GROUP}/CONCESSION/{EVENT}/{ob.subject_key}"
+        owner = intents._owner_obligation(st, component)
+        assert owner is ob
+        liability = RoleKey(
+            "ASC606", "US01", component, "REFUND_LIABILITY", "CONTRACT_LIABILITY", None, None
+        )
+        found = resolve(ctx, owner, liability)
+        assert found is not None
+        assert (found.account_code, found.step) == (ob.account_overrides["CONTRACT_LIABILITY"], 1)
+        assert found.source.ref_id == f"{ob.subject_key}#account_overrides/CONTRACT_LIABILITY"
+        # A role the owner does not override is not resolved through the owner (the intents loop
+        # then takes the ordinary component path: mapping rules under the contract scope).
+        refund = RoleKey(
+            "ASC606", "US01", component, "REFUND_LIABILITY", "REFUND_LIABILITY", None, None
+        )
+        assert "REFUND_LIABILITY" not in owner.account_overrides
+        unresolved = resolve(ctx, owner, refund)
+        assert unresolved is None or unresolved.step == 3
