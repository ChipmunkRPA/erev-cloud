+        base.content_sha256,
+        tuple(
+            dataclasses.replace(rule, default_dimensions={"department": "D-MAP"})
+            if (rule.account_role, rule.clearing_purpose) == (CL, None)
+            else rule
+            for rule in base.rules
+        ),
+    )
+    ctx = dataclasses.replace(book_context(bundles.entity(months=1)), mapping=with_default)
