+# D-98 candidate 109b (draft): the refund-liability component kinds an obligation owns (S14-R-26 rev
+# 1.18 / D-98 35a ownership). Their lines resolve accounts through the owning obligation's
+# overrides (T-REF-15 step 1); the subject of every role key stays the component key.
+_OBLIGATION_OWNED_COMPONENTS: Final = frozenset({"RETURN", "CONCESSION", "UNCLAIMED_PROPERTY"})
+
+
+def _owner_obligation(st: AllocatedState, subject_key: str) -> ObligationState | None:
+    """The obligation a refund-liability component key ``<group>@<entity>/<KIND>/<source>`` names
+    through its source, by exact CV-21 encoded identity (D-98 candidate 109b, draft; Codex 1517):
+    ``RETURN`` and ``UNCLAIMED_PROPERTY`` — the source IS an obligation subject key of the state;
+    ``CONCESSION`` — the source is ``<event key>/<obligation subject key>`` where the event key is
+    an event of the state and the remainder an obligation subject key of the state. No suffix or
+    substring guess, no lookup through openings (a contract without a baseline resolves the same
+    way), and never an obligation for a contract-owned kind (``TERMINATION``,
+    ``VARIABLE_CONSIDERATION``) or for any other subject: None."""
+    head, _, rest = subject_key.partition("/")
+    kind, _, source = rest.partition("/")
+    if "@" not in head or kind not in _OBLIGATION_OWNED_COMPONENTS or not source:
+        return None
+    by_key = {ob.subject_key: ob for ob in st.obligations}
+    if kind != "CONCESSION":
+        return by_key.get(source)
+    for event_key in sorted(ev.event_key for ev in st.events):
+        if source.startswith(f"{event_key}/"):
+            return by_key.get(source[len(event_key) + 1 :])
+    return None
+
+
